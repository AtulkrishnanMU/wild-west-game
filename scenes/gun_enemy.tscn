[sub_resource type="Shader" id="Shader_enemy_hit"]
code = "shader_type canvas_item;
uniform float hit_silhouette = 0.0;
void fragment() {
    vec4 tex = texture(TEXTURE, UV);
    if (hit_silhouette > 0.5) {
        COLOR = vec4(vec3(1.0), tex.a);
    } else {
        COLOR = tex;
    }
}"

